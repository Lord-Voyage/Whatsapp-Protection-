# Copy to .env for local development. Never commit .env or the DATA_DIR contents.

# HTTP port. Render injects its own PORT automatically; leave unset there.
PORT=3000

# Where SQLite (whatsapp-protection.sqlite) and Baileys auth files (auth/) are stored.
# On Render this must be the persistent disk mount: /data
DATA_DIR=./data

# Optional (recommended): primary bot owner's WhatsApp number, international digits only
# (e.g. 256700000000). If unset, the first number paired on the website becomes the primary
# bot account. All other numbers pair on the website or by sending /pair to the bot.
OWNER_NUMBER=

# Optional: maximum number of linked accounts this server will host (each one is a
# separate WhatsApp connection using memory). 0 = no limit. Default: 100.
MAX_LINKED_ACCOUNTS=100

# Log levels: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=warn

# Optional: bot replies use WhatsApp button messages by default. Set to false to send standard
# image/text messages instead (for WhatsApp clients that do not display button messages).
INTERACTIVE_BUTTONS=true

# Optional: the WhatsApp Channel that accounts auto-follow and that replies show as their source.
CHANNEL_JID=120363409908822540@newsletter
CHANNEL_NAME=❖ WhatsApp Protection ❖

NODE_ENV=development
